{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "where-not-rain-trip",
  "main": "./dist/index.js",
  "compatibility_date": "2026-08-07",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 }
  },
  "vars": {
    "WEB_ORIGIN": "http://localhost:3000",
    "AUTH_BASE_URL": "http://localhost:8787",
    "EMAIL_FROM": "Where Not Rain <noreply@868656.xyz>"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wnr-trip-production",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "env": {
    "preview": {
      "name": "where-not-rain-trip-preview",
      "workers_dev": true,
      "vars": {
        "WEB_ORIGIN": "https://where-not-rain.pages.dev",
        "AUTH_BASE_URL": "https://where-not-rain-trip-preview.ct1150.workers.dev",
        "EMAIL_FROM": "Where Not Rain <noreply@868656.xyz>"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "wnr-trip-preview",
          "database_id": "11111111-1111-1111-1111-111111111111"
        }
      ]
    },
    "production": {
      "name": "where-not-rain-trip-production",
      "workers_dev": true,
      "routes": [
        {
          "pattern": "trip.868656.xyz",
          "custom_domain": true
        }
      ],
      "vars": {
        "WEB_ORIGIN": "https://868656.xyz",
        "AUTH_BASE_URL": "https://trip.868656.xyz",
        "EMAIL_FROM": "Where Not Rain <noreply@868656.xyz>"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "wnr-trip-production",
          "database_id": "00000000-0000-0000-0000-000000000000"
        }
      ]
    }
  }
}
