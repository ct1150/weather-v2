{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "where-not-rain-trip",
  "main": "./dist/index.js",
  "compatibility_date": "2026-08-07",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
  },
  "vars": {
    "WEB_ORIGIN": "http://localhost:3000",
    "AUTH_BASE_URL": "http://localhost:8787",
    "EMAIL_FROM": "Where Not Rain <noreply@868656.xyz>",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wnr-trip-production",
      "database_id": "d8ffa28b-87dc-414e-b35c-068b1c70c39a",
    },
  ],
  "services": [
    {
      "binding": "WEATHER_READ",
      "service": "where-not-rain-read",
    },
  ],
  "env": {
    "preview": {
      "name": "where-not-rain-trip-preview",
      "workers_dev": true,
      "vars": {
        "WEB_ORIGIN": "https://where-not-rain.pages.dev",
        "AUTH_BASE_URL": "https://where-not-rain-trip-preview.ct1150.workers.dev",
        "EMAIL_FROM": "Where Not Rain <noreply@868656.xyz>",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "wnr-trip-preview",
          "database_id": "e0fcd786-4a32-43fe-bff6-e05d6c1a922f",
        },
      ],
      "services": [
        {
          "binding": "WEATHER_READ",
          "service": "where-not-rain-read-preview",
        },
      ],
    },
    "production": {
      "name": "where-not-rain-trip-production",
      "workers_dev": true,
      "routes": [
        {
          "pattern": "trip.868656.xyz",
          "custom_domain": true,
        },
      ],
      "triggers": {
        "crons": ["37 */6 * * *"],
      },
      "vars": {
        "WEB_ORIGIN": "https://868656.xyz",
        "AUTH_BASE_URL": "https://trip.868656.xyz",
        "EMAIL_FROM": "Where Not Rain <noreply@868656.xyz>",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "wnr-trip-production",
          "database_id": "d8ffa28b-87dc-414e-b35c-068b1c70c39a",
        },
      ],
      "services": [
        {
          "binding": "WEATHER_READ",
          "service": "where-not-rain-read-production",
        },
      ],
    },
  },
}
