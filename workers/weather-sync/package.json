{
  "name": "@wnr/weather-sync",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "seed:prod": "wrangler d1 execute wnr-weather --env production --remote --file ../../packages/db/seeds/0001_cities_jp_kr_sea.sql",
    "seed:preview": "wrangler d1 execute wnr-weather --env preview --remote --file ../../packages/db/seeds/0001_cities_jp_kr_sea.sql"
  },
  "dependencies": {
    "@wnr/domain": "workspace:*",
    "@wnr/weather": "workspace:*",
    "@wnr/db": "workspace:*",
    "@wnr/config": "workspace:*"
  },
  "devDependencies": {
    "@wnr/tsconfig": "workspace:*",
    "@wnr/eslint-config": "workspace:*",
    "@wnr/vitest-config": "workspace:*",
    "@wnr/test-utils": "workspace:*"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ]
}
