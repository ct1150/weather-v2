{
  "name": "where-not-rain",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --write apps/web/src/app/destination-pages.test.ts && git diff -- apps/web/src/app/destination-pages.test.ts && exit 1",
    "docs:test": "node --test tooling/docs/*.test.mjs",
    "docs:check": "node tooling/docs/validate-docs.mjs --mode active",
    "indexnow:submit": "node tooling/deploy/submit-indexnow.mjs",
    "test": "pnpm -r test",
    "deploy": "pnpm --filter @wnr/web exec wrangler pages deploy out --project-name where-not-rain",
    "deploy:preview": "pnpm --filter @wnr/web exec wrangler pages deploy out --branch preview --project-name where-not-rain"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@types/node": "^22.10.2",
    "@wnr/eslint-config": "workspace:*",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "wrangler": "^3.90.0"
  }
}
