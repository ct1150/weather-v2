# Where Not Rain — build-time configuration (DEP-CONFIG-001 subset)
#
# Copy to `.env` for local builds. NO real secrets belong here.
# Secrets (CLOUDFLARE_API_TOKEN, CLOUDFLARE_ACCOUNT_ID) live ONLY in GitHub
# Actions Secrets and are never written to files, logs, or client bundles.

# Build/runtime environment identity, injected at `next build` time.
APP_ENV=production
APP_BASE_URL=https://where-not-rain.pages.dev
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en,ja,ko,zh-cn,zh-tw

# Staleness threshold (minutes) used for the baked "data updated" label.
WEATHER_DATA_MAX_AGE_MINUTES=60

# --- DISABLED this phase (documented for future enablement only) ------------
# The static-export MVP bakes deterministic FAKE weather (FakeWeatherProvider)
# at build time; no real provider or secret is used. These stay commented out.
# WEATHER_PRIMARY_PROVIDER=weatherapi
# WEATHER_FALLBACK_PROVIDER=open-meteo
# WEATHERAPI_SECRET=            # never set here; use Cloudflare Secrets only
