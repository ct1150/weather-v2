# Where Not Rain — build-time configuration (DEP-CONFIG-001 subset)
#
# Copy to `.env` for local builds. NO real secrets belong here.
# Secrets (CLOUDFLARE_API_TOKEN, CLOUDFLARE_ACCOUNT_ID) live ONLY in GitHub
# Actions Secrets and are never written to files, logs, or client bundles.

# Build/runtime environment identity, injected at `next build` time.
APP_ENV=production
APP_BASE_URL=https://where-not-rain.pages.dev
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en,ja,ko,zh-cn,zh-tw

# Staleness threshold (minutes) used for the baked "data updated" label.
WEATHER_DATA_MAX_AGE_MINUTES=60

# --- DISABLED this phase (documented for future enablement only) ------------
# The static-export MVP bakes deterministic FAKE weather (FakeWeatherProvider)
# at build time; no real provider or secret is used. These stay commented out.
# WEATHER_PRIMARY_PROVIDER=weatherapi
# WEATHER_FALLBACK_PROVIDER=open-meteo
# WEATHERAPI_SECRET=            # never set here; use Cloudflare Secrets only

# --- Weather provider selection (PRD-INC-001) -------------------------------
# Picks the sync-worker adapter via WEATHER_PRIMARY_PROVIDER. The static web build
# keeps using the FAKE provider at build time (no real provider in the browser
# bundle); this value drives the backend weather-sync Worker only.
# Legal values: open-meteo | fake | weatherapi (weatherapi is reserved/disabled).
WEATHER_PRIMARY_PROVIDER=open-meteo

# --- Cloudflare Web Analytics (PRD-INC-004) ---------------------------------
# Public beacon token (NOT a secret — it is embedded in the static HTML). Injected at
# build time as a NEXT_PUBLIC_* var on the Pages project. Keep the switch "false" and
# leave the token blank to ship ZERO analytics integration (zero integration by default).
CLOUDFLARE_ANALYTICS_ENABLED=false
NEXT_PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN=

# --- Product analytics -------------------------------------------------------
NEXT_PUBLIC_PRODUCT_ANALYTICS_URL=

# --- Affiliate surfaces ------------------------------------------------------
# These are public build-time configuration values. Do not put API secrets or private
# credentials in either variable. With either value empty, commercial UI is zero-fill.
#
# The first monetization slots are intentionally the post-destination-decision actions:
#   discovery.hotel
#   discovery.activities
#
# Example local enablement:
# NEXT_PUBLIC_AFFILIATE_SLOTS=discovery.hotel,discovery.activities
# NEXT_PUBLIC_AFFILIATE_OFFERS_JSON=[{"id":"hotel-tokyo","providerId":"approved-hotel-provider","category":"hotel","slot":"discovery.hotel","destinationId":"tokyo","href":"https://approved.example/hotel/tokyo","dataState":"current","normalizedHostAllowlist":["approved.example"],"allowedPathPrefixes":["/hotel/"]},{"id":"activities-tokyo","providerId":"approved-activities-provider","category":"activities","slot":"discovery.activities","destinationId":"tokyo","href":"https://approved.example/activities/tokyo","dataState":"current","normalizedHostAllowlist":["approved.example"],"allowedPathPrefixes":["/activities/"]}]
#
# Production should populate these from GitHub Actions Variables only after a provider
# agreement/link is approved. Never fabricate partner URLs or imply a commercial contract.
NEXT_PUBLIC_AFFILIATE_SLOTS=
NEXT_PUBLIC_AFFILIATE_OFFERS_JSON=
