+        .sort();
+      return {
+        digest: digestRequirementSelection(blocks, ids),
+        ids,
+        path: sourcePath,
+      };
+    })
+    .filter((source) => source.ids.length > 0)
+    .sort((left, right) => left.path.localeCompare(right.path));
