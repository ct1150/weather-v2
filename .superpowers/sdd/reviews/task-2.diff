+  if (state.mode === "active") {
+    for (const trace of state.traces) {
+      if (trace.coverage === "Needs Decision") {
+        addIssue(
+          state,
+          "NEEDS_DECISION",
+          trace.filePath,
+          `Unresolved trace decision for ${trace.requirementId}`,
+        );
+      }
+    }
+  }
